# ============================================================
# Honeypot Lab - Variables de entorno
# Copia este archivo como .env y ajusta los valores.
# NUNCA subas .env al repositorio (ver .gitignore)
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=honeypot
POSTGRES_PASSWORD=CAMBIAR_EN_.env
POSTGRES_DB=honeypot

# --- n8n ---
# Obligatoria: genera una clave fija, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_ENCRYPTION_KEY=reemplazar_con_clave_aleatoria
GENERIC_TIMEZONE=America/Argentina/Mendoza

# --- n8n autenticacion del editor (seguimiento D4, NO habilitado) ---
# El editor de n8n (http://localhost:5678) actualmente NO tiene autenticacion:
# aceptable solo por tratarse de un laboratorio local aislado. Habilitar basic
# auth es el seguimiento documentado (D4); descomentar estas variables y
# recrear el contenedor n8n para activarlo:
#N8N_BASIC_AUTH_ACTIVE=true
#N8N_BASIC_AUTH_USER=admin
#N8N_BASIC_AUTH_PASSWORD=reemplazar_con_password_fuerte

# --- Alertas (opcional; dejar vacío para desactivar) ---
# Token del bot de Telegram. NUNCA lo subas al repo.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Webhook alternativo para alertas (opcional)
ALERT_WEBHOOK_URL=
