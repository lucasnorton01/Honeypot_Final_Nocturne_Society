# ============================================================
# Honeypot Lab - Variables de entorno
# Copia este archivo como .env y ajusta los valores.
# NUNCA subas .env al repositorio (ver .gitignore)
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=.usuario_ejemplo
POSTGRES_PASSWORD=contrasena_ejemplo_cambiar
POSTGRES_DB=nombre_db_ejemplo

# --- n8n ---
# Obligatoria: genera una clave fija, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_ENCRYPTION_KEY=reemplazar_con_clave_aleatoria
GENERIC_TIMEZONE=America/Argentina/Mendoza

# --- Alertas (opcional; dejar vacío para desactivar) ---
# Token del bot de Telegram. NUNCA lo subas al repo.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Webhook alternativo para alertas (opcional)
ALERT_WEBHOOK_URL=
