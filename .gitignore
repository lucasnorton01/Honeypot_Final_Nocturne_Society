# ============================================================
# Honeypot Lab - .gitignore
# ============================================================

# ─── Secretos y configuración local ─────────────────────────
.env
API/.env
*.env.local
*.env.production

# ─── Backups de base de datos ────────────────────────────────
db/backup.sql
*.sql.gz
*.dump

# ─── Node.js ────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# ─── Python ──────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# ─── Docker (volúmenes de datos) ────────────────────────────
n8n-data/
pg-data/
cowrie-var/

# ─── Bases de datos locales ─────────────────────────────────
*.sqlite
*.sqlite3

# ─── Evidencia y logs generados ─────────────────────────────
evidencia/
Logs/
logs 10 septiembre/
*.log

# ─── Sistema operativo ──────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# ─── IDEs / Editores ────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ─── Archivos temporales del setup ──────────────────────────
script_entorno/*.tmp
script_entorno/*.bak

# ─── PostgreSQL dump temporal ────────────────────────────────
db/*.sql
!db/schema.sql
