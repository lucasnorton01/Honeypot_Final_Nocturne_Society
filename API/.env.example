# Cowrie Web — Variables de entorno
# Copiar a .env y ajustar según el entorno

# Puerto del servidor web
PORT=4000

# Cowrie SSH (puerto expuesto por Docker)
COWRIE_HOST=localhost
COWRIE_SSH_PORT=2222
COWRIE_TELNET_PORT=2323

# PostgreSQL (debe coincidir con docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=honeypot
DB_USER=nocturne
DB_PASSWORD=nocturne2025
