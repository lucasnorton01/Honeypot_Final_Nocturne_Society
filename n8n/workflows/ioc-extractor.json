            ],
            "parameters": {}
        },
        {
            "id": "wf-ioc-query-unprocessed",
            "name": "Postgres: Eventos sin procesar",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 2,
            "position": [
                260,
                300
            ],
            "parameters": {
                "operation": "executeQuery",
                "query": "SELECT id, eventid, src_ip, username, password, input, message, timestamp FROM events WHERE processed = FALSE ORDER BY id ASC LIMIT 500"
            },
            "credentials": {
                "postgres": {
                    "name": "Postgres",
                    "id": "E56uxYa034ezaNIn"
                }
            }
        },
        {
            "id": "wf-ioc-extract",
            "name": "Extraer IoCs",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                520,
                300
            ],
            "parameters": {
                "mode": "runOnceForAllItems",
                "language": "javaScript",
                "jsCode": "const out = [];\nfor (const item of items) {\n  const e = item.json;\n  const eventId = e.id;\n  const found = [];\n  if (e.src_ip && e.eventid === 'cowrie.session.connect') {\n    found.push({ type: 'ip', value: String(e.src_ip) });\n  }\n  if (e.username && e.password) {\n    found.push({ type: 'credential', value: `${e.username}:${e.password}` });\n  }\n  if (e.input && e.input.match(/wget|curl|nc |python|\\/bin|sh |bash|chmod|tftp/i)) {\n    found.push({ type: 'command', value: String(e.input).slice(0, 500) });\n  }\n  if (e.message && e.message.includes('sha256')) {\n    const m = e.message.match(/[a-f0-9]{64}/);\n    if (m) found.push({ type: 'hash', value: m[0] });\n  }\n  const valuesSql = found.length\n    ? found.map(f => `('${f.type}', '${String(f.value).replace(/'/g, \"''\")}', ${eventId}, 'cowrie')`).join(',')\n    : '(NULL,NULL,NULL,NULL)';\n  out.push({ json: { event_id: eventId, produced_ioc: found.length > 0, values_sql: valuesSql } });\n}\nreturn out;"
            }
        },
        {
            "id": "wf-ioc-upsert",
            "name": "Postgres: Upsert IoCs",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 2,
            "position": [
                780,
                300
            ],
            "parameters": {
                "operation": "executeQuery",
                "query": "WITH ins AS (\n  INSERT INTO iocs (type, value, event_id, source)\n  SELECT type, value, event_id::bigint, source FROM (VALUES {{ $json.values_sql }}) AS v(type, value, event_id, source)\n  WHERE type IS NOT NULL\n  ON CONFLICT (type, value) DO NOTHING\n), obs AS (\n  INSERT INTO ioc_observations (event_id, produced_ioc) VALUES ({{ $json.event_id }}, {{ $json.produced_ioc }})\n)\nUPDATE events SET processed = TRUE WHERE id = {{ $json.event_id }}",
                "options": {
                    "queryBatching": "independently"
                }
            },
            "credentials": {
                "postgres": {
                    "name": "Postgres",
                    "id": "E56uxYa034ezaNIn"
                }
            }
        }
    ],
    "connections": {
