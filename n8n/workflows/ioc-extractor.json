                  {
                      "id":  "wf-ioc-extract",
                      "name":  "Extraer IoCs",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       520,
                                       300
                                   ],
                      "parameters":  {
                                         "mode":  "runOnceForAllItems",
                                         "language":  "javaScript",
                                         "jsCode":  "const out = [];\nfor (const item of items) {\n  const e = item.json;\n  const eventId = e.id;\n  if (e.src_ip) {\n    out.push({ json: { event_id: eventId, ioc_type: \u0027ip\u0027, ioc_value: String(e.src_ip), source: \u0027cowrie\u0027 } });\n  }\n  if (e.username \u0026\u0026 e.password) {\n    out.push({ json: { event_id: eventId, ioc_type: \u0027credential\u0027, ioc_value: `${e.username}:${e.password}`, source: \u0027cowrie\u0027 } });\n  }\n  if (e.input \u0026\u0026 e.input.match(/wget|curl|nc |python|\\/bin|sh |bash|chmod|tftp/i)) {\n    out.push({ json: { event_id: eventId, ioc_type: \u0027command\u0027, ioc_value: String(e.input).slice(0, 500), source: \u0027cowrie\u0027 } });\n  }\n  if (e.message \u0026\u0026 e.message.includes(\u0027sha256\u0027)) {\n    const m = e.message.match(/[a-f0-9]{64}/);\n    if (m) out.push({ json: { event_id: eventId, ioc_type: \u0027hash\u0027, ioc_value: m[0], source: \u0027cowrie\u0027 } });\n  }\n}\nreturn out;"
                                     }
                  },
